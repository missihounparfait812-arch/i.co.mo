# ============================================
# I.CO.MO — Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez vos valeurs.
# NE COMMITEZ JAMAIS le fichier .env

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données ---
# Chemin relatif depuis la racine du projet
DB_PATH=backend/data/icomo.db

# --- Authentification ---
# Clé secrète pour signer les JWT (générez une chaîne aléatoire longue)
JWT_SECRET=CHANGEZ_MOI_avec_une_cle_secrete_aleatoire_64_caracteres
JWT_EXPIRES_IN=24h

# --- Admin initial ---
# Utilisé uniquement par le script de seed (npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# --- WhatsApp ---
WHATSAPP_NUMBER=225XXXXXXXXXX

# --- Upload images ---
# Taille max en octets (5 Mo par défaut)
MAX_FILE_SIZE=5242880
